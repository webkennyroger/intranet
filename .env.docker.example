# Copie para ".env.docker" e preencha. NUNCA commite o .env.docker.
APP_NAME="Intranet DPEMT"
APP_ENV=production
APP_DEBUG=false
# Gere com: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://intranet.seu-dominio.gov.br
APP_TIMEZONE=America/Cuiaba
APP_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Atrás de proxy/load balancer com HTTPS. Use "*" só se o container NÃO
# estiver exposto direto à internet.
TRUSTED_PROXIES=*

MAIL_MAILER=log
